---
import { skillGroups } from "../data/skills";
---

<section>
  <h2 id="skills">スキル</h2>

  {
    skillGroups.map((group) => (
      <>
        <h3 class="group-title">{group.group}</h3>
        <ul class="skill-list">
          {group.items.map((skill) => (
            <li>
              <span class="skill-name">{skill.name}</span>
              <span class="skill-use">{skill.use}</span>
              <span class="skill-years">{skill.years}</span>
              {skill.desc && <p class="skill-desc">{skill.desc}</p>}
            </li>
          ))}
        </ul>
      </>
    ))
  }
</section>

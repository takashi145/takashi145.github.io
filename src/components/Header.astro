---
const navItems = [
  { href: "#about", label: "自己紹介" },
  { href: "#history", label: "経歴" },
  { href: "#skills", label: "スキル" },
  { href: "#certifications", label: "資格・検定" },
  { href: "#works", label: "制作物" },
];
---

<header class="site-header">
  <p class="site-title">~/takashi145</p>
  <nav class="site-nav">
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <button id="theme-toggle" type="button"></button>
</header>

<script>
  // 表示テーマ切り替え（Light → Dark → System）
  (function () {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;

    const root = document.documentElement;
    const media = window.matchMedia("(prefers-color-scheme: dark)");
    const MODES = ["light", "dark", "system"];
    const LABELS: Record<string, string> = {
      light: "Light",
      dark: "Dark",
      system: "System",
    };

    const currentMode = () => {
      const saved = localStorage.getItem("theme");
      return saved === "light" || saved === "dark" ? saved : "system";
    };

    const applyTheme = () => {
      const mode = currentMode();
      const dark = mode === "dark" || (mode === "system" && media.matches);
      if (dark) {
        root.setAttribute("data-theme", "dark");
      } else {
        root.removeAttribute("data-theme");
      }
      btn.textContent = LABELS[mode];
      btn.title = "表示テーマ: " + LABELS[mode] + "（クリックで切り替え）";
    };

    btn.addEventListener("click", () => {
      const next = MODES[(MODES.indexOf(currentMode()) + 1) % MODES.length];
      if (next === "system") {
        localStorage.removeItem("theme");
      } else {
        localStorage.setItem("theme", next);
      }
      applyTheme();
    });

    media.addEventListener("change", () => {
      if (currentMode() === "system") applyTheme();
    });

    applyTheme();
  })();

  (function () {
    const items = [
      ...document.querySelectorAll<HTMLAnchorElement>(".site-nav a[href^='#']"),
    ]
      .map((a) => ({
        a,
        el: document.getElementById(a.getAttribute("href")!.slice(1)),
      }))
      .filter((item) => item.el);
    if (items.length === 0) return;

    const offset = () =>
      parseFloat(getComputedStyle(items[0].el!).scrollMarginTop) + 1;
    let current: (typeof items)[number] | null = null;
    let ticking = false;

    const sync = () => {
      ticking = false;
      let active = items[0];
      const limit = offset();
      for (const item of items) {
        if (item.el!.getBoundingClientRect().top <= limit) active = item;
      }
      // 最下部では最後のセクションを選択
      if (
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 2
      ) {
        active = items[items.length - 1];
      }
      if (active === current) return;
      current = active;
      items.forEach((item) =>
        item.a.classList.toggle("is-current", item === active),
      );
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(sync);
    };

    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll);
    sync();
  })();
</script>
